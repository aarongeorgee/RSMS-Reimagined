{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rsms-reimagined-web",
  "compatibility_date": "2026-09-23",

  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },

  "images": {
    "binding": "IMAGES"
  },

  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
