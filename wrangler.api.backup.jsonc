{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "rsms-reimagined-web",
  "main": "worker/index.ts",

  "compatibility_date": "2026-09-23",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rsms-db",
      "database_id": "5a1b2acd-d4c2-43be-9e2f-90073599e518"
    }
  ]
,
  "assets": { "directory": "dist/client", "not_found_handling": "none", "binding": "ASSETS" }
,
  "images": { "binding": "IMAGES" }
,
  "version_metadata": {"binding":"CF_VERSION_METADATA"}
,
  "cache": {"enabled":false}
,
  "services": [{"binding":"RESPONSE_STORE","service":"rsms-reimagined-web-response-store","entrypoint":"ResponseStoreService"}]
}